// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
  EMPLOYEE
}

enum VehicleCategory {
  ECONOMY
  COMPACT
  MID_SIZE
  FULL_SIZE
  SUV
  LUXURY
  VAN
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServicePricingType {
  PER_DAY
  FIXED
  PERCENTAGE
}

enum MaintenanceType {
  SERVICE
  REPAIR
  INSPECTION
  BLOCKED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum SettingCategory {
  GENERAL
  PAYMENT
  EMAIL
  BOOKING
  OTHER
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  phone               String?
  role                UserRole  @default(CLIENT)
  password            String
  emailVerified       DateTime?
  image               String?
  driverLicense       String?
  lockedUntil         DateTime? // Verrouillage temporaire après échecs
  failedLoginAttempts Int       @default(0) // Nombre d'échecs consécutifs
  deletedAt           DateTime? // Soft delete pour conformité RGPD
  originalEmailHash   String?   // Hash de l'email original pour traçabilité légale (SHA-256)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bookings      Booking[]
  reviews       Review[]
  invoices      Invoice[]
  payments      Payment[]
  preferences   UserPreferences?

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNotifications    Boolean  @default(true)
  bookingReminders      Boolean  @default(true)
  promotionalEmails     Boolean  @default(false)
  marketingEmails       Boolean  @default(false)
  language              String   @default("fr")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Location {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String
  postalCode   String
  country      String
  phone        String?
  email        String?
  latitude     Float?
  longitude    Float?
  openingHours Json     // Structure: { day: { open: string, close: string, closed?: boolean } }
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles     Vehicle[]
  pickupBookings  Booking[] @relation("PickupLocation")
  returnBookings   Booking[] @relation("ReturnLocation")

  @@map("locations")
}

model Vehicle {
  id            String          @id @default(cuid())
  brand         String
  model         String
  year          Int
  licensePlate  String          @unique
  mileage       Int
  category      VehicleCategory
  seats         Int
  transmission  TransmissionType
  fuelType      FuelType
  color         String
  pricePerDay   Float
  pricePerWeek  Float?
  pricePerMonth Float?
  deposit       Float
  status        VehicleStatus   @default(AVAILABLE)
  locationId    String
  features      String[]        @default([])
  images        String[]
  imagePublicIds String[]       @default([])
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  location      Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  reviews       Review[]
  maintenances  Maintenance[]

  @@index([status, category])
  @@index([locationId])
  @@index([licensePlate])
  @@map("vehicles")
}

model Service {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  price                 Float
  pricingType           ServicePricingType
  availableForCategories VehicleCategory[]  @default([])
  icon                  String?
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([active])
  @@map("services")
}

model Booking {
  id                String        @id @default(cuid())
  reference         String        @unique
  userId            String
  vehicleId         String
  startDate         DateTime
  endDate           DateTime
  pickupLocationId  String
  returnLocationId  String
  totalPrice        Float
  depositPaid       Float         @default(0)
  remainingAmount   Float
  status            BookingStatus @default(PENDING)
  serviceIds        String[]      @default([]) // Array of Service IDs
  notes             String?
  cancellationReason String?
  cancelledAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  pickupLocation    Location      @relation("PickupLocation", fields: [pickupLocationId], references: [id], onDelete: Restrict)
  returnLocation    Location      @relation("ReturnLocation", fields: [returnLocationId], references: [id], onDelete: Restrict)
  
  review            Review?
  invoices          Invoice[]
  payments          Payment[]

  @@index([userId])
  @@index([vehicleId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([reference])
  @@map("bookings")
}

model Review {
  id        String       @id @default(cuid())
  bookingId String       @unique
  userId    String
  vehicleId String
  rating    Int          // 1-5
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  booking  Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([status])
  @@index([bookingId])
  @@map("reviews")
}

model Maintenance {
  id          String            @id @default(cuid())
  vehicleId   String
  type        MaintenanceType
  status      MaintenanceStatus @default(SCHEDULED)
  startDate   DateTime
  endDate     DateTime
  description String?
  cost        Float
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("maintenances")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  bookingId     String
  userId        String
  subtotal      Float
  tax           Float         @default(0)
  total         Float
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Payment {
  id            String         @id @default(cuid())
  bookingId     String
  invoiceId     String?
  userId        String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus  @default(PENDING)
  transactionId String?
  metadata      Json?          // Flexible JSON for payment gateway data
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model Setting {
  id          String          @id @default(cuid())
  key         String          @unique
  value       Json            // Flexible: string, number, boolean, object
  description String?
  category    SettingCategory @default(GENERAL)
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([key])
  @@map("settings")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // Email ou userId
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([identifier])
  @@map("verification_tokens")
}

model RateLimitAttempt {
  id         String   @id @default(cuid())
  identifier String   // Email ou IP
  type       String   // "email" ou "ip"
  createdAt  DateTime @default(now())

  @@index([identifier, type, createdAt])
  @@index([createdAt])
  @@map("rate_limit_attempts")
}
